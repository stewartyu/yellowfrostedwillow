---
import { Image } from 'astro:assets';
import Layout from '../layouts/Layout.astro';
import portrait from '../assets/anna-may-wong-1924.jpg';
// The venue asks for its logo on all marketing materials. Their file is white for dark
// backgrounds; this is the same artwork in our ink colour with a transparent background.
import venueLogo from '../assets/dont-tell-mama-logo.png';

// Alphabetical by last name, so the list doesn't rank anyone.
const cast = [
  'Kai An Chee',
  'Marina Kondo',
  'Noi Maeshige',
  'Bart Mather',
  'Charles Romaine',
  'Sam Tanabe',
  'James Wong',
  'Xiaoqing Zhang',
];

const ticketsUrl = 'https://shows.donttellmamanyc.com/show/yellow-frosted-willow-a-new-musical-in-concert/';
const venueMapUrl = 'https://www.google.com/maps/search/?api=1&query=Don%27t+Tell+Mama+343+W+46th+St+New+York+NY';
// Public domain in the US (published 1924); credited anyway.
const portraitSourceUrl = 'https://commons.wikimedia.org/wiki/File:Anna_May_Wong_1924.jpg';
---

<Layout title="Yellow Frosted Willow: The Anna May Wong Musical">
  <header class="topbar label">
    <span>In concert</span>
    <span>Nov 23 · NYC</span>
  </header>

  <div class="hero">
    <figure class="print">
      <Image
        class="print__photo"
        src={portrait}
        alt="Anna May Wong in 1924, wearing a satin turban, her hands raised beside her face"
        widths={[400, 700, 1000]}
        sizes="(min-width: 860px) 420px, calc(100vw - 64px)"
        loading="eager"
        fetchpriority="high"
      />
      <figcaption class="print__caption">
        Anna May Wong, 1924. Photograph by <a href={portraitSourceUrl}>Edwin Bower Hesser</a>.
      </figcaption>
    </figure>

    <div class="hero__text">
      <div class="title">
        <h1 class="title__en">Yellow<br />Frosted<br /><span>Willow</span></h1>
        <!-- Her Chinese name, with its pronunciation beside it; sitting next to the English
             title is what tells readers the two are the same name. -->
        <p class="title__name">
          <span class="title__han" lang="zh-Hant">黃柳霜</span>
          <span class="title__romanization"><span>Wong</span> <span>Liu</span> <span>Tsong</span></span>
        </p>
      </div>
      <p class="label title__tagline">The Anna May Wong Musical</p>
      <p class="credits title__credits">
        Book <b>Angela Wong</b> <span aria-hidden="true">·</span> Music &amp; Lyrics <b>Stewart Yu</b>
      </p>
    </div>
  </div>

  <main class="content">
    <section class="section" aria-labelledby="concert">
      <h2 id="concert" class="label label--accent">In concert · One night only</h2>
      <div class="date-row">
        <p class="date">Nov. 23<br />7pm</p>
        <Image class="venue-logo" src={venueLogo} alt="Don't Tell Mama" width={124} />
      </div>
      <div class="venue">
        <p class="muted">
          Don't Tell Mama<br />
          Brick Room, <a href={venueMapUrl}>343 W. 46th St</a>
        </p>
        <a class="button" href={ticketsUrl}>Get tickets</a>
      </div>
      <p class="muted small">
        Monday, November 23, 2026. The first concert of songs from the show, with music direction by Minhui Lee.
        Doors 6:15pm. $25 cover plus a $20 minimum (must include 2 drinks), cash only.
      </p>
    </section>

    <section class="section" aria-labelledby="story">
      <h2 id="story" class="label label--accent">The story</h2>
      <p>
        Born in Los Angeles as Hollywood was taking shape, Anna May Wong falls in love with the movies, saving her
        lunch money for the nickelodeon. Against her father's wishes, she leaves the family laundry to become an
        actress, and runs straight into the hard reality of race in casting.
      </p>
      <p>
        Pigeonholed as the “dragon lady” or the “butterfly,” and shamed at home for how she portrays her culture, she
        searches for acceptance from Hollywood, the American public, and her own heritage.
      </p>
    </section>

    <section class="section" aria-labelledby="featuring">
      <h2 id="featuring" class="label label--accent">Featuring</h2>
      <ul class="cast">
        {cast.map((name) => <li>{name}</li>)}
      </ul>
    </section>

    <!-- Its own section, with her name set like the cast names, so the music director doesn't read as secondary. -->
    <section class="section section--tight" aria-labelledby="music-director">
      <h2 id="music-director" class="label label--accent">Music director &amp; pianist</h2>
      <ul class="cast cast--single">
        <li>Minhui Lee</li>
      </ul>
    </section>

    <section class="section" aria-labelledby="listen">
      <h2 id="listen" class="label label--accent">Listen</h2>
      <p class="song">“Anything I Dream”</p>
      <iframe
        class="soundcloud"
        width="100%"
        height="120"
        scrolling="no"
        frameborder="no"
        allow="autoplay"
        title="Anything I Dream — Yellow Frosted Willow on SoundCloud"
        src="https://w.soundcloud.com/player/?url=https%3A//api.soundcloud.com/tracks/2417982585&auto_play=false&hide_related=true&show_comments=false&show_user=false&show_reposts=false&visual=false&color=%23a8192a"
      ></iframe>
      <p class="muted small">Composer demo</p>
    </section>
  </main>
</Layout>

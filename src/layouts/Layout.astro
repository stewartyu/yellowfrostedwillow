---
import { getImage } from 'astro:assets';
import portrait from '../assets/anna-may-wong-1924.jpg';
import '../styles/main.scss';

interface Props {
  title: string;
}

const { title } = Astro.props;
const description =
  "Yellow Frosted Willow: The Anna May Wong Musical, about Hollywood's first Chinese-American movie star.";

// Link previews get a modest JPEG rather than the full-size original.
const ogImage = await getImage({ src: portrait, width: 1200, format: 'jpg' });
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={Astro.url} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={new URL(ogImage.src, Astro.site)} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Libre+Caslon+Display&family=Libre+Caslon+Text:ital@0;1&family=Work+Sans:wght@400;600&display=swap"
      rel="stylesheet"
    />
    <!-- Only the three characters of her name, so the CJK font stays tiny. -->
    <link
      href="https://fonts.googleapis.com/css2?family=Noto+Serif+TC:wght@600&text=%E9%BB%83%E6%9F%B3%E9%9C%9C&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <slot />

    <footer class="footer label">© {new Date().getFullYear()} Yellow Frosted Willow</footer>
  </body>
</html>
